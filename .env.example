# Plantilla de configuración. Copie este archivo con el nombre ".env"
# y reemplace los valores. El archivo .env NO se sube a GitHub.

# --- Base de datos local (la que usa la aplicación en este computador) ---
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASSWORD=escriba_aqui_su_contrasena
DB_NAME=fercho_db

# --- Base de datos en la nube (Neon) ---
# Solo se usa para instalar y revisar la base publicada. La aplicación
# local NO la usa. Pegue la cadena de conexión que entrega Neon.
DATABASE_URL_NUBE=
